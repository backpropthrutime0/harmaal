# Harmaal configuration — copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
# Local (host) connection; in docker-compose the host is `db` not `localhost`.
DATABASE_URL=postgresql+asyncpg://harmaal_admin:supersecretpassword@localhost:5432/harmaal_erp
POSTGRES_USER=harmaal_admin
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=harmaal_erp

# --- Runtime ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Quick local dev without Alembic (creates tables on startup). Keep false in prod.
AUTO_CREATE_TABLES=false

# --- Auth / JWT ---
# Must be >=32 chars and non-default in production.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_at_least_32_chars_xx
JWT_EXPIRE_HOURS=8
MFA_TOKEN_EXPIRE_MINUTES=5
TOTP_ISSUER=Harmaal

# --- Seed root admin (created on first startup if absent) ---
ROOT_EMAIL=admin@harmaal.local
ROOT_PASSWORD=changeme

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
